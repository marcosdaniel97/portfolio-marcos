---
import TerminalPrompt from './TerminalPrompt.astro';
import SocialIcon from './SocialIcon.astro';
---

<footer class="footer">
  <p class="footer__echo">
    <TerminalPrompt glyph="$">echo "Copyright 2026 Marcos Daniel Casimiro. Todos los derechos reservados."</TerminalPrompt>
  </p>

  <div class="footer__socials">
    <SocialIcon icon="github" href="https://github.com/marcosdaniel97" label="GitHub de Marcos Daniel Casimiro" />
    <SocialIcon
      icon="linkedin"
      href="https://www.linkedin.com/in/marcos-daniel-casimiro-017937190"
      label="LinkedIn de Marcos Daniel Casimiro"
    />
    <SocialIcon
      icon="email"
      href="mailto:mdcasimiro@gmail.com"
      label="Enviar un email a Marcos Daniel Casimiro"
      external={false}
    />
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-6);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .footer__echo {
    color: var(--color-text-muted);
    font-size: var(--fs-100);
    word-break: break-word;
  }

  .footer__socials {
    display: flex;
    gap: var(--space-2);
  }
</style>
