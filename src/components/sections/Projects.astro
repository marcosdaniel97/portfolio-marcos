---
import TerminalPrompt from '../ui/TerminalPrompt.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<section id="projects" class="section reveal" aria-labelledby="projects-heading">
  <h2 id="projects-heading" class="section__heading">
    <TerminalPrompt glyph="$">./ejecutar_proyectos.sh</TerminalPrompt>
  </h2>

  <div class="projects__grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
  }
</style>
