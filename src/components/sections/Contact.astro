---
import TerminalPrompt from '../ui/TerminalPrompt.astro';
import SocialIcon from '../ui/SocialIcon.astro';
---

<section id="contact" class="section reveal" aria-labelledby="contact-heading">
  <h2 id="contact-heading" class="section__heading">
    <TerminalPrompt glyph="$">contact.sh</TerminalPrompt>
  </h2>

  <div class="contact__body">
    <a class="contact__cta" href="mailto:mdcasimiro@gmail.com">Enviar un email</a>

    <div class="contact__socials">
      <SocialIcon icon="github" href="https://github.com/marcosdaniel97" label="GitHub de Marcos Daniel Casimiro" />
      <SocialIcon
        icon="linkedin"
        href="https://www.linkedin.com/in/marcos-daniel-casimiro-017937190"
        label="LinkedIn de Marcos Daniel Casimiro"
      />
    </div>
  </div>
</section>

<style>
  .contact__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
  }

  .contact__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    background-color: var(--color-accent);
    color: var(--color-bg-base);
    font-family: var(--font-mono);
    font-weight: 600;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .contact__cta:hover,
  .contact__cta:focus-visible {
    background-color: var(--color-accent-dim);
  }

  .contact__socials {
    display: flex;
    gap: var(--space-2);
  }
</style>
